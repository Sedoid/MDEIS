# MDEIS environment. Copy to .env (`make env-init` does this and fills the generated values).
# This file lists names and safe placeholders only. Real values live in .env, which is not tracked.
#
# Each variable has a tag on the line above it:
#   [you]       you must supply the value (it stays "change-me" until you do)
#   [generate]  `make env-init` fills in a random value
#   [default]   works as it is; change only if you need to
#   [optional]  may stay empty
# `make check-env` fails and names every [you] or [generate] variable still set to "change-me".

# ── Stack identity ───────────────────────────────────────────────────

# [default] Docker Compose project name. Prefixes networks and volumes.
COMPOSE_PROJECT_NAME=mdeis

# [default] Added to the end of every container name, for example postgres-mdeis.
STACK_SUFFIX=mdeis

# [default] Host address the published ports bind to. Keep 127.0.0.1 and reach the stack over an SSH tunnel.
HOST_BIND=127.0.0.1

# [default] Host port for Open WebUI (the one port a user needs).
WEBUI_PORT=3000

# [default] Host port for the n8n editor. Published only while DEV_EDITOR=1 in the Makefile.
N8N_EDITOR_PORT=5678

# [default] Host port for the upload page (portal).
PORTAL_PORT=8080

# [default] Timezone for containers that care about it.
TZ=UTC

# ── Images (exact tags, never latest) ────────────────────────────────

# [default] Postgres 16 with pgvector 0.8.7.
PGVECTOR_IMAGE=pgvector/pgvector:0.8.7-pg16-bookworm

# [default] llama.cpp server, pinned by digest (build b11541, amd64 and arm64).
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:bf3da52e92c083472b3d1c9f9da081f423ab9def95a87ec4bba51940382d75fd

# [default] n8n.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.42.6

# [default] Open WebUI.
WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.4

# [default] Borrowed read-only Postgres MCP server (crystaldba/postgres-mcp, MIT). Pending your pick in T-027.
PG_MCP_IMAGE=crystaldba/postgres-mcp:0.3.0

# [default] Base image for the Python containers we build.
PYTHON_IMAGE=python:3.12.15-slim-bookworm

# ── Postgres ─────────────────────────────────────────────────────────

# [default] Postgres superuser name. Used only by the init script and admin commands.
POSTGRES_USER=postgres

# [generate] Postgres superuser password.
POSTGRES_PASSWORD=change-me

# [default] Maintenance database created by the Postgres image.
POSTGRES_DB=postgres

# [default] MDEIS database name.
MDEIS_DB_NAME=mdeis

# [default] Role that owns the MDEIS schema. Used by mdeis-mcp and the migration step.
MDEIS_APP_USER=mdeis_app

# [generate] Password for the MDEIS app role.
MDEIS_APP_PASSWORD=change-me

# [default] Read-only role used by the borrowed MCP server.
MDEIS_RO_USER=mdeis_ro

# [generate] Password for the read-only role.
MDEIS_RO_PASSWORD=change-me

# [default] n8n database name.
N8N_DB_NAME=n8n

# [default] Role that owns n8n's own tables. It cannot read the MDEIS database.
N8N_DB_USER=n8n_app

# [generate] Password for the n8n role.
N8N_DB_PASSWORD=change-me

# [default] Orchestrator database name (its own conversation checkpoints live here).
ORCHESTRATOR_DB_NAME=orchestrator

# [default] Role that owns the orchestrator database. It cannot connect to the MDEIS database.
ORCHESTRATOR_DB_USER=orchestrator_app

# [generate] Password for the orchestrator role.
ORCHESTRATOR_DB_PASSWORD=change-me

# [default] Portal role. In the MDEIS database it can only add and read document rows (granted by the migration).
PORTAL_DB_USER=portal_app

# [generate] Password for the portal role.
PORTAL_DB_PASSWORD=change-me

# [default] Read-only role n8n uses to read released-report views in the MDEIS database. No writes, no base tables.
N8N_AUTO_DB_USER=n8n_auto

# [generate] Password for the n8n read-only role.
N8N_AUTO_DB_PASSWORD=change-me

# ── Embedder (nomic-embed-text-v1.5, Apache-2.0, 768 dimensions) ─────

# [default] Folder on the host that holds the model file. `make models` fills it.
MODELS_DIR=./models

# [default] Model file name.
EMBED_MODEL_FILE=nomic-embed-text-v1.5.f16.gguf

# [default] Where `make models` downloads it from (pinned to a commit of the Hugging Face repo).
EMBED_MODEL_URL=https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF/resolve/0188c9bf409793f810680a5a431e7b899c46104c/nomic-embed-text-v1.5.f16.gguf

# [default] SHA-256 of the model file. `make models` refuses a file that does not match.
EMBED_MODEL_SHA256=f7af6f66802f4df86eda10fe9bbcfc75c39562bed48ef6ace719a251cf1c2fdb

# [default] Vector size the model produces. The database column must match (T-003).
EMBED_DIM=768

# [default] Memory limit for the embedder container.
EMBEDDER_MEM_LIMIT=1g

# ── Identity and the gate ────────────────────────────────────────────

# [generate] Signs and verifies the approver token. Held by gateway and mdeis-mcp only.
APPROVER_TOKEN_SECRET=change-me

# [generate] Shared key between Open WebUI and the gateway.
GATEWAY_API_KEY=change-me

# [generate] Shared key between the gateway and the orchestrator.
ORCHESTRATOR_API_KEY=change-me

# [generate] Signs the upload page's CSRF tokens. Held by the portal only.
PORTAL_SESSION_SECRET=change-me

# [default] Where the browser opens Open WebUI, for the chat link and frame on the upload page.
# On a server, use its address with the same host name you type for the upload page, for example
# http://203.0.113.5:3000 (cookies are shared by host name, not by port, so the two pages must
# use the same host name).
WEBUI_PUBLIC_URL=http://127.0.0.1:3000

# [optional] The address people type for the upload page, if it is different from the one the page
# is reached at (for example behind the public proxy). Leave empty otherwise.
PORTAL_PUBLIC_URL=

# [default] Largest PDF the upload page takes, in megabytes. A Markdown methodology is capped at 1.
MAX_UPLOAD_MB=10

# [default] true shows the chat inside the upload page. false shows only a link.
PORTAL_FRAME_CHAT=true

# ── Model (held by the orchestrator only) ────────────────────────────

# [you] Your OpenRouter key from openrouter.ai.
OPENROUTER_API_KEY=change-me

# [you] Pinned open-weights model slug, for example vendor/model-name (decision H-6 / D-007).
OPENROUTER_MODEL=change-me

# [you] Provider to pin on OpenRouter. Fallbacks stay off.
OPENROUTER_PROVIDER=change-me

# [default] OpenRouter API base URL. Change it to point at a local model.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# [default] Must stay false: the pinned model is never swapped for another one.
OPENROUTER_ALLOW_FALLBACKS=false

# [default] Must stay deny: OpenRouter may not keep or train on our prompts.
OPENROUTER_DATA_COLLECTION=deny

# [default] Second-check model (Jev). off = not used. When on, it can only hold a report, never release one.
JEV_MODE=off

# [optional] Pinned slug of the second-check model. Only read when JEV_MODE is not off.
JEV_MODEL=

# [optional] Score at or above which the second check holds a report.
JEV_HOLD_THRESHOLD=

# ── Agent behaviour ──────────────────────────────────────────────────

# [default] linear = the plain tool-calling loop (the fallback). graph = the LangGraph agent. Use graph once it has run.
ORCHESTRATOR_MODE=linear

# [default] Most model calls in one run before the agent stops and says so.
ORCHESTRATOR_MAX_STEPS=12

# [default] How many times a draft that fails the citation check is written again before the agent stops.
ORCHESTRATOR_MAX_REDRAFTS=2

# [default] Must stay false until a named person unlocks the class view (counts only, no names).
CLASS_VIEW_ENABLED=false

# ── n8n ──────────────────────────────────────────────────────────────

# [generate] Encrypts credentials stored by n8n.
N8N_ENCRYPTION_KEY=change-me

# [default] Webhook the orchestrator calls for the annotated explainer. The path is set by the workflow.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/mdeis-annotate

# [generate] Key the orchestrator sends in a header to that webhook. The workflow rejects calls without it.
N8N_WEBHOOK_KEY=change-me

# [optional] n8n's own model key, if a workflow needs one. Kept apart from the orchestrator's so spend is capped separately.
N8N_OPENROUTER_API_KEY=

# [default] Set true only if you serve n8n over HTTPS.
N8N_SECURE_COOKIE=false

# ── Open WebUI ───────────────────────────────────────────────────────

# [generate] Signs Open WebUI sessions.
WEBUI_SECRET_KEY=change-me

# [default] Email of the first administrator, created on first start. This is the signed-in approver's login.
WEBUI_ADMIN_EMAIL=approver@example.com

# [default] Display name of the first administrator. This name appears in the action log.
WEBUI_ADMIN_NAME=Demo Approver

# [generate] Password of the first administrator.
WEBUI_ADMIN_PASSWORD=change-me

# [default] Set true only when Open WebUI is served over HTTPS (the public proxy), so the sign-in cookie never travels in clear.
WEBUI_SESSION_COOKIE_SECURE=false

# ── Public address (optional, profile "prod": make prod-up) ──────────

# [default] The host name the public proxy answers to. localhost = Caddy's own local certificate.
APP_HOST=localhost

# [default] Which proxy file to use. Caddyfile = the page and the chat (needs a domain name and https). Caddyfile.page = the static page only, over plain http, for a bare IP address. Caddyfile.ip = the chat, the upload page (/portal/) and the static page on one port, over plain http, for a bare IP address.
CADDYFILE=Caddyfile

# [default] Address the proxy binds to. 127.0.0.1 = not public. Set 0.0.0.0 on the server on purpose, and only then.
PROXY_BIND=127.0.0.1

# ── Tracing (optional, off by default) ───────────────────────────────

# [optional] Langfuse public key. Leave empty to run without tracing.
LANGFUSE_PUBLIC_KEY=

# [optional] Langfuse secret key.
LANGFUSE_SECRET_KEY=

# [optional] Langfuse address.
LANGFUSE_HOST=
